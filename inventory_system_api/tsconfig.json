{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",

    "rootDir": ".",
    "outDir": "./dist",
    "types": ["node", "jest"],

    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "generated"],
  "exclude": ["node_modules", "dist"]
}
