{
  "openapi": "3.0.0",
  "info": {
    "title": "Inventory System API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Login",
        "security": [],
        "responses": {
          "200": {
            "description": "Authenticated"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register a company + first admin using an activation code",
        "security": [],
        "responses": {
          "200": {
            "description": "Company created; returns access/refresh tokens and user"
          },
          "401": {
            "description": "Invalid activation code"
          }
        }
      }
    },
    "/leads": {
      "post": {
        "summary": "Public demo/contact request (emails the platform owner)",
        "security": [],
        "responses": {
          "201": {
            "description": "Request received"
          },
          "400": {
            "description": "Missing required fields"
          },
          "429": {
            "description": "Too many requests"
          }
        }
      }
    },
    "/super-admin/create": {
      "post": {
        "summary": "Bootstrap the first super-admin (requires x-bootstrap-secret header)",
        "security": [],
        "responses": {
          "201": {
            "description": "Super-admin created"
          },
          "403": {
            "description": "Invalid or missing bootstrap secret, or one already exists"
          }
        }
      }
    },
    "/super-admin/login": {
      "post": {
        "summary": "Super-admin login",
        "security": [],
        "responses": {
          "200": {
            "description": "Returns a super-admin token"
          }
        }
      }
    },
    "/super-admin/activation-codes": {
      "get": {
        "summary": "List activation codes (super-admin token)"
      },
      "post": {
        "summary": "Create an activation code (super-admin token)"
      }
    },
    "/auth/change-password": {
      "post": {
        "summary": "Change current user password",
        "responses": {
          "200": {
            "description": "Password changed"
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "List products"
      },
      "post": {
        "summary": "Create product"
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "Get product"
      },
      "put": {
        "summary": "Update product"
      },
      "delete": {
        "summary": "Delete product"
      }
    },
    "/assets": {
      "get": {
        "summary": "List assets"
      },
      "post": {
        "summary": "Create asset"
      }
    },
    "/users": {
      "get": {
        "summary": "List users"
      },
      "post": {
        "summary": "Create/invite user"
      }
    },
    "/truck-stock/trucks": {
      "get": {
        "summary": "List trucks"
      },
      "post": {
        "summary": "Create truck"
      }
    },
    "/truck-stock/templates": {
      "get": {
        "summary": "List stock templates"
      },
      "post": {
        "summary": "Create stock template"
      }
    },
    "/truck-stock/assignments": {
      "get": {
        "summary": "List assignments"
      },
      "post": {
        "summary": "Assign template to truck"
      }
    },
    "/truck-stock/my-stock": {
      "get": {
        "summary": "Current technician truck stock"
      }
    },
    "/truck-stock/low-stock": {
      "get": {
        "summary": "Low stock alerts"
      }
    },
    "/truck-stock/receipts/upload": {
      "post": {
        "summary": "Upload receipt file as base64 JSON",
        "responses": {
          "201": {
            "description": "File URL created"
          }
        }
      }
    },
    "/truck-stock/receipts": {
      "get": {
        "summary": "List receipts"
      },
      "post": {
        "summary": "Create receipt using uploaded fileUrl"
      }
    },
    "/truck-stock/movements": {
      "get": {
        "summary": "Truck stock movement history"
      }
    },
    "/reports/inventory": {
      "get": {
        "summary": "Inventory summary report"
      }
    },
    "/reports/assets": {
      "get": {
        "summary": "Assets summary report"
      }
    }
  }
}