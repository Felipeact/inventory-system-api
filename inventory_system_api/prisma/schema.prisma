// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String    @id @default(uuid())
  name      String
  users     User[]
  roles     Role[]
  products  Product[]
  assets    Asset[]
  createdAt DateTime  @default(now())

  plan               String @default("STARTER")
  subscriptionStatus String @default("ACTIVE")
  maxUsers           Int    @default(3)
  maxProducts        Int    @default(100)

  trucks              Truck[]
  truckStockTemplates TruckStockTemplate[]
  purchaseReceipts    PurchaseReceipt[]
}

model User {
  id           String @id @default(uuid())
  name         String @default("")
  email        String
  passwordHash String
  companyId    String
  roleId       String

  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  refreshTokens       RefreshToken[]
  userPermissions     UserPermission[]
  passwordResetTokens PasswordResetToken[]

  trucks                  Truck[]                @relation("TruckTechnician")
  createdTruckTemplates   TruckStockTemplate[]   @relation("TruckTemplateCreator")
  createdTruckAssignments TruckStockAssignment[] @relation("TruckAssignmentCreator")
  truckReceipts           PurchaseReceipt[]      @relation("TruckReceiptTechnician")
  truckStockMovements     TruckStockMovement[]   @relation("TruckStockMovementUser")

  @@unique([email, companyId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  companyId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Role {
  id        String @id @default(uuid())
  name      String
  companyId String

  company Company @relation(fields: [companyId], references: [id])
  users   User[]

  rolePermissions RolePermission[]

  @@unique([name, companyId])
}

model Permission {
  id   String @id @default(uuid())
  name String @unique

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String @id @default(uuid())
  userId       String
  permissionId String

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([userId, permissionId])
}

model Product {
  id                String @id @default(uuid())
  name              String
  barcode           String
  companyId         String
  lowStockThreshold Int    @default(5)

  company   Company    @relation(fields: [companyId], references: [id])
  inventory Inventory?

  @@unique([barcode, companyId])
}

model Inventory {
  id        String @id @default(uuid())
  productId String @unique
  quantity  Int
  companyId String

  product Product @relation(fields: [productId], references: [id])
}

model ActivationCode {
  id        String  @id @default(uuid())
  code      String  @unique
  isUsed    Boolean @default(false)
  companyId String?

  plan        String @default("STARTER")
  maxUsers    Int    @default(3)
  maxProducts Int    @default(100)

  isActive Boolean @default(true)
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String
  companyId String
  details   String?
  createdAt DateTime @default(now())
}

model Asset {
  id          String   @id @default(uuid())
  name        String
  type        String
  serialCode  String
  status      String   @default("active")
  companyId   String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([serialCode, companyId])
}

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Truck {
  id          String  @id @default(cuid())
  truckNumber String
  plateNumber String?
  status      String  @default("ACTIVE")

  companyId    String
  technicianId String?

  company    Company @relation(fields: [companyId], references: [id])
  technician User?   @relation("TruckTechnician", fields: [technicianId], references: [id])

  stockAssignments TruckStockAssignment[]
  receiptUploads   PurchaseReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TruckStockTemplate {
  id        String  @id @default(cuid())
  name      String
  tradeType String?

  companyId   String
  createdById String

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation("TruckTemplateCreator", fields: [createdById], references: [id])

  items       TruckStockItem[]
  assignments TruckStockAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TruckStockItem {
  id String @id @default(cuid())

  templateId String

  productName String
  category    String?

  requiredQuantity Int
  currentQuantity  Int @default(0)

  minimumQuantity Int @default(1)

  expectedPrice Float?

  unit String?

  notes String?

  template  TruckStockTemplate   @relation(fields: [templateId], references: [id])
  movements TruckStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TruckStockAssignment {
  id String @id @default(cuid())

  truckId    String
  templateId String

  assignedById String

  truck Truck @relation(fields: [truckId], references: [id])

  template TruckStockTemplate @relation(fields: [templateId], references: [id])

  assignedBy User @relation("TruckAssignmentCreator", fields: [assignedById], references: [id])

  createdAt DateTime @default(now())
}

model PurchaseReceipt {
  id String @id @default(cuid())

  companyId    String
  technicianId String
  truckId      String

  fileUrl String

  status String @default("PENDING")

  totalAmount Float?

  company Company @relation(fields: [companyId], references: [id])

  technician User @relation("TruckReceiptTechnician", fields: [technicianId], references: [id])

  truck Truck @relation(fields: [truckId], references: [id])

  items ReceiptItem[]

  createdAt DateTime @default(now())
}

model ReceiptItem {
  id String @id @default(cuid())

  receiptId String

  itemName String

  quantity Int

  unitPrice Float?

  totalPrice Float?

  receipt PurchaseReceipt @relation(fields: [receiptId], references: [id])

  createdAt DateTime @default(now())
}

model TruckStockMovement {
  id String @id @default(cuid())

  truckStockItemId String

  action String

  previousQuantity Int
  newQuantity      Int

  changedById String

  notes String?

  truckStockItem TruckStockItem @relation(fields: [truckStockItemId], references: [id])

  changedBy User @relation("TruckStockMovementUser", fields: [changedById], references: [id])

  createdAt DateTime @default(now())
}
