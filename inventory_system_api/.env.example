# ─────────────────────────────────────────────────────────────
# Inventory System API – environment configuration
# Copy this file to `.env` and fill in real values before running.
# All variables are validated on startup by src/config/env.ts;
# the process exits if a required one is missing or malformed.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL connection string) — REQUIRED
DATABASE_URL="postgresql://user:password@localhost:5432/inventory?sslmode=require"

# Connection pool tuning (optional)
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# JWT secrets — REQUIRED. Generate strong, DISTINCT values with: openssl rand -hex 32
# In production the app refuses to start with short or placeholder secrets.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"

# One-time secret required to create the FIRST super-admin via POST /super-admin/create
# (send it as the `x-bootstrap-secret` request header). REQUIRED in production (16+ chars):
# the bootstrap endpoint is closed unless the request presents this exact value.
# Generate with: openssl rand -hex 32
SUPER_ADMIN_BOOTSTRAP_SECRET=""

# Server
PORT=3000
NODE_ENV=development          # development | test | production
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# CORS — comma-separated list of allowed frontend origins. REQUIRED in production.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# SMTP Email — OPTIONAL. If any of HOST/USER/PASS/FROM is blank, email delivery is
# disabled and password-reset/invite/welcome flows become no-ops (no crash).
# Set all four to enable email.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Frontend URL used to build links inside emails — OPTIONAL until a frontend exists.
FRONTEND_URL=""

# File storage for uploaded receipts
# local = filesystem (dev or a mounted persistent volume); s3 = S3-compatible bucket.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads            # used by the local driver (relative to the working dir)

# S3 / Cloudflare R2 settings — REQUIRED when STORAGE_DRIVER=s3
S3_BUCKET=""
S3_REGION="auto"             # use "auto" for Cloudflare R2
S3_ENDPOINT=""               # e.g. https://<account>.r2.cloudflarestorage.com (blank for AWS S3)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""        # public/CDN base URL, e.g. https://cdn.example.com

# Desktop app auto-update (optional)
APP_VERSION="1.0.0"
UPDATE_DOWNLOAD_URL=""
