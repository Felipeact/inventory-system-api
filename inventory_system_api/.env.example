# ─────────────────────────────────────────────────────────────
# Inventory System API – environment configuration
# Copy this file to `.env` and fill in real values before running.
# All variables are validated on startup by src/config/env.ts;
# the process exits if a required one is missing or malformed.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL connection string) — REQUIRED
DATABASE_URL="postgresql://user:password@localhost:5432/inventory?sslmode=require"

# Connection pool tuning (optional)
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# JWT secrets — REQUIRED. Use long, random values (e.g. `openssl rand -hex 32`)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"

# Server
PORT=3000
NODE_ENV=development          # development | test | production
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# CORS — comma-separated list of allowed frontend origins. REQUIRED in production.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# SMTP Email — REQUIRED (password reset, invites, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@example.com"

# Frontend URL used to build links inside emails — REQUIRED
FRONTEND_URL="http://localhost:3001"

# Desktop app auto-update (optional)
APP_VERSION="1.0.0"
UPDATE_DOWNLOAD_URL=""
