# ─────────────────────────────────────────────────────────────
# Inventory System API – environment configuration
# Copy this file to `.env` and fill in real values before running.
# All variables are validated on startup by src/config/env.ts;
# the process exits if a required one is missing or malformed.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL connection string) — REQUIRED
DATABASE_URL="postgresql://user:password@localhost:5432/inventory?sslmode=require"

# Connection pool tuning (optional)
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# JWT secrets — REQUIRED. Generate strong, DISTINCT values with: openssl rand -hex 32
# In production the app refuses to start with short or placeholder secrets.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"

# OPTIONAL one-time secret that gates the web/HTTP bootstrap of the FIRST super-admin
# via POST /super-admin/create (sent as the `x-bootstrap-secret` header).
#  - If SET (must be 16+ chars in production): /admin/setup and the create endpoint work.
#  - If LEFT BLANK: that HTTP endpoint is disabled in production and you create the first
#    super-admin with `npm run seed` instead. The API boots fine either way.
# Generate with: openssl rand -hex 32   (avoid quotes/spaces/newlines when pasting)
SUPER_ADMIN_BOOTSTRAP_SECRET=""

# Server
PORT=3000
NODE_ENV=development          # development | test | production
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# CORS — comma-separated list of allowed frontend origins. REQUIRED in production.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# SMTP Email — OPTIONAL. If any of HOST/USER/PASS/FROM is blank, email delivery is
# disabled and password-reset/invite/welcome/notification flows become no-ops (no crash).
# Set all four to enable email.
#
# Gmail example (recommended for a single mailbox):
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an "App password" (Google Account → Security → App passwords).
#   3. Use the 16-character app password (NOT your normal password) as SMTP_PASS.
#     SMTP_HOST="smtp.gmail.com"
#     SMTP_PORT=587
#     SMTP_USER="felipetiburcioviana@gmail.com"
#     SMTP_PASS="your-16-char-app-password"
#     SMTP_FROM="Inventory System <felipetiburcioviana@gmail.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Resend (https://resend.com) — RECOMMENDED on hosts that block outbound SMTP
# (e.g. Railway). When RESEND_API_KEY is set, email is sent over HTTPS and SMTP_*
# is ignored. In Resend "test mode" (no verified domain) you can send FROM the
# shared onboarding sender TO the email you signed up with — perfect for getting
# owner notifications to your own inbox. Verify a domain to email arbitrary users.
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"   # or "You <you@your-verified-domain.com>"

# Where operational notifications go (new sign-ups, super-admin creation, demo
# requests). Defaults to the platform owner; emails only send once a provider is set.
ADMIN_NOTIFICATION_EMAIL="felipetiburcioviana@gmail.com"

# Frontend URL used to build links inside emails (e.g. password reset) — set this to
# your deployed web app, e.g. https://app.example.com
FRONTEND_URL=""

# ── First-run seed (npm run seed) — OPTIONAL ──────────────────────────────────
# Used only by the idempotent seed script to bootstrap the first super-admin and a
# sample activation code so you can register immediately. Safe defaults are built in.
SEED_SUPER_ADMIN_EMAIL=""        # default: admin@inventory.local
SEED_SUPER_ADMIN_PASSWORD=""     # default: ChangeMe!2026 (change after first login)
SEED_ACTIVATION_CODE=""          # default: TEST-2026
SEED_ACTIVATION_PLAN=""          # default: PRO
SEED_ACTIVATION_MAX_USERS=""     # default: 25
SEED_ACTIVATION_MAX_PRODUCTS=""  # default: 5000

# File storage for uploaded receipts
# local = filesystem (dev or a mounted persistent volume); s3 = S3-compatible bucket.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads            # used by the local driver (relative to the working dir)

# S3 / Cloudflare R2 settings — REQUIRED when STORAGE_DRIVER=s3
S3_BUCKET=""
S3_REGION="auto"             # use "auto" for Cloudflare R2
S3_ENDPOINT=""               # e.g. https://<account>.r2.cloudflarestorage.com (blank for AWS S3)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""        # public/CDN base URL, e.g. https://cdn.example.com

# Desktop app auto-update (optional)
APP_VERSION="1.0.0"
UPDATE_DOWNLOAD_URL=""

# AI assistant (optional) — powers the in-app Claude assistant that can answer
# questions, build reports, and take actions over a company's own data.
# If left blank, the /ai endpoints return a friendly 503 and the rest of the API
# is unaffected. Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=""
# Claude model the assistant uses (defaults to the latest Opus).
AI_MODEL="claude-opus-4-8"

# Stripe billing (optional) — self-serve, per-seat subscriptions. If STRIPE_SECRET_KEY is
# blank the /billing endpoints return a friendly 503 and the rest of the API is unaffected.
# Use a TEST key (sk_test_…) while developing.
#  1. Create two recurring, per-seat Prices in the Stripe dashboard (one per plan) and put
#     their IDs in STRIPE_PRICE_PRO / STRIPE_PRICE_BUSINESS.
#  2. Add a webhook endpoint pointing at  <API_URL>/billing/webhook  subscribed to
#     checkout.session.completed and customer.subscription.{created,updated,deleted};
#     copy its signing secret (whsec_…) into STRIPE_WEBHOOK_SECRET.
#  3. FRONTEND_URL (above) is used for the checkout success/cancel and portal return URLs.
# Stripe pays out to your connected bank account — funds do not pass through PayPal.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# One recurring, per-seat Stripe Price per self-serve plan (Starter/Pro/Business).
# Plan limits and AI access are defined in code (src/config/plans.ts), not here.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""
