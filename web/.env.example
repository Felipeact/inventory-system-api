# ===========================================================================
# Web app environment (Next.js). Copy to `.env.local` for local development.
#
# NOTE ON STRIPE: the web app has NO Stripe key of its own. Stripe Checkout is
# hosted by Stripe and driven entirely by the API, so there is no publishable
# key in the browser. To test Stripe, just point NEXT_PUBLIC_API_BASE_URL at an
# API instance running Stripe TEST-mode keys (sk_test_… / whsec_… / test
# price_… IDs live in the API's own .env, not here).
# ===========================================================================

# Base URL of the Inventory System API (no trailing slash).
# Used by the browser, so it must be reachable from the client.
# REQUIRED for production builds — `next build` fails if this is unset in production.
#
# Local development: http://localhost:3000  (the API's default port)
# Production (Railway): set this to your deployed API, e.g.
#   NEXT_PUBLIC_API_BASE_URL=https://inventory-system-api-production.up.railway.app
# IMPORTANT: the API's CORS_ORIGINS must include THIS web app's origin.
NEXT_PUBLIC_API_BASE_URL=https://inventory-system-api-production.up.railway.app

# Canonical public URL of this site (no trailing slash). Drives OpenGraph/canonical
# tags, robots.txt and sitemap.xml. Defaults to https://stockvio.app.
#
# Local development: the API defaults to port 3000, so run the web on another
# port to avoid a clash (`npm run dev -- -p 3001`) and set this to match, e.g.
#   NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Also set the API's FRONTEND_URL to this same origin so Stripe redirects back here.
NEXT_PUBLIC_SITE_URL=https://stockvio.app

# Where "request a demo" submissions are emailed/forwarded (optional display only).
NEXT_PUBLIC_SALES_EMAIL=sales@stockvio.app
